#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -ge 1 && $# -le 2 ]] || fail 'Usage: site-database-delete domain [suffix]'
load_site "$1"; db=''; suffix=${2:-}
registry=$(extra_registry); [[ -f $registry ]] || fail 'No additional databases registered'
if [[ -n $suffix ]]; then
 suffix=${suffix,,}; suffix=${suffix//-/_}; valid_suffix "$suffix" || fail 'Invalid suffix'
 db=$(short_db_name "${DB_NAME}_${suffix}")
else
 mapfile -t databases < <(cut -f1 "$registry")
 ((${#databases[@]})) || { echo 'No additional databases'; exit 0; }
 for i in "${!databases[@]}"; do printf '[%d] %s\n' "$((i+1))" "${databases[i]}"; done
 read -rp 'Select (0=cancel): ' choice
 [[ $choice =~ ^[0-9]+$ ]] || fail 'Invalid selection'
 ((10#$choice > 0 && 10#$choice <= ${#databases[@]})) || exit 0
 db=${databases[10#$choice-1]}
fi
registered_extra "$db" || fail 'Database not registered to this site'
IFS=$'\t' read -r found user separate < <(awk -F'\t' -v db="$db" '$1==db{print $1"\t"$2"\t"$3;exit}' "$registry")
[[ $found == "$db" && $db != "$DB_NAME" && $db =~ ^[a-z0-9_]{1,64}$ && $user =~ ^[a-z0-9_]{1,64}$ ]] || fail 'Invalid registry'
read -rp "Permanently delete $db? Type DELETE: " confirm
[[ $confirm == DELETE ]] || exit 0
mysql -e "DROP DATABASE \`$db\`;"
if [[ $separate == yes ]]; then mysql -e "DROP USER IF EXISTS '$user'@'localhost';"; fi
awk -F'\t' -v db="$db" '$1 != db' "$registry" > "$registry.tmp"; mv "$registry.tmp" "$registry"; chmod 600 "$registry"
if [[ -f "$CRED_FILE" ]]; then
 sed -i "/^### DATABASE-BEGIN: $db$/,/^### DATABASE-END: $db$/d" "$CRED_FILE"
fi
echo "Deleted $db"
