#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -ge 1 && $# -le 2 ]] || fail 'Usage: site-database-create domain [suffix]'
load_site "$1"; suffix=${2:-}
if [[ -z $suffix ]]; then read -rp 'Additional database suffix: ' suffix; fi
suffix=${suffix,,}; suffix=${suffix//-/_}
valid_suffix "$suffix" || fail 'Suffix must be 1..32 lowercase letters, digits, underscore'
DB_EXTRA=$(short_db_name "${DB_NAME}_${suffix}")
[[ $DB_EXTRA != "$DB_NAME" ]] || fail 'Database name collision'
! registered_extra "$DB_EXTRA" || fail 'Already registered'
[[ $(mysql -NBe "SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$DB_EXTRA'") == 0 ]] || fail 'Database already exists'
echo "[1] Use site DB account: $SITE_USER"
echo '[2] Create separate DB account (name derived from DB name)'
read -rp 'Select [1/2]: ' choice
case "$choice" in
 1) user="$SITE_USER"; separate=no; pass='';;
 2) user=$(short_db_name "${SITE_USER}_${suffix}"); separate=yes; pass=$(openssl rand -hex 24)
    [[ $(mysql -NBe "SELECT COUNT(*) FROM mysql.user WHERE User='$user' AND Host='localhost'") == 0 ]] || fail 'Account exists';;
 *) fail 'Invalid selection';;
esac
read -rp "Create $DB_EXTRA for $DOMAIN? Type CREATE: " yes
[[ $yes == CREATE ]] || exit 0
mysql -e "CREATE DATABASE \`$DB_EXTRA\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
if [[ $separate == yes ]]; then mysql -e "CREATE USER '$user'@'localhost' IDENTIFIED BY '$pass';"; fi
mysql -e "GRANT ALL PRIVILEGES ON \`$DB_EXTRA\`.* TO '$user'@'localhost';"
printf '%s\t%s\t%s\n' "$DB_EXTRA" "$user" "$separate" >> "$(extra_registry)"
if [[ $separate == yes ]]; then
 cat >> "$CRED_FILE" <<CRED
### DATABASE-BEGIN: $DB_EXTRA
Database: $DB_EXTRA
DB user: $user
DB pass: $pass
DB host: localhost
### DATABASE-END: $DB_EXTRA
CRED
fi
echo "Created database: $DB_EXTRA (user: $user)"
