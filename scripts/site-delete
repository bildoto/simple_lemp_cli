#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -ge 1 ]] || fail 'Usage: site-delete domain [--confirm] [--purge-data]'
load_site "$1"; shift
CONFIRM=0; PURGE=0
for arg in "$@"; do case "$arg" in --confirm) CONFIRM=1;; --purge-data) PURGE=1;; *) fail "Unknown option $arg";; esac; done
if (( CONFIRM && ! PURGE )); then fail 'Deletion requires --purge-data; use site-disable to disable a site.'; fi
printf 'Site: %s\nUser: %s\nWeb: %s\nDatabase: %s\n' "$DOMAIN" "$SITE_USER" "$WEB_ROOT" "$DB_NAME"
echo 'Registered additional databases:'
[[ ! -f $(extra_registry) ]] || cut -f1 "$(extra_registry)"
if (( ! CONFIRM )); then echo 'Dry run. Use --confirm --purge-data to permanently delete site resources. To disable, use site-disable.'; exit 0; fi
[[ "$WEB_ROOT" == "$WEB_BASE/$DOMAIN" && "$FPM_CONF" == "$FPM_DIR/$SITE_USER.conf" ]] || fail 'Path validation failed'
[[ ! -L "$WEB_ROOT" && ! -L "$INC_DIR" ]] || fail 'Refusing symlink paths'
if [[ -f "$FPM_CONF" ]]; then grep -Fxq "[$SITE_USER]" "$FPM_CONF" || fail 'Pool mismatch'; fi
if [[ -f "$NGX_CONF" ]]; then grep -Fq "server_name $DOMAIN;" "$NGX_CONF" || fail 'Server name mismatch'; fi
if [[ -L "$NGX_LINK" ]]; then [[ $(readlink "$NGX_LINK") == "$NGX_CONF" ]] || fail 'Link mismatch'; fi
if [[ -L "$NGX_LINK" ]]; then mv "$NGX_LINK" "$NGX_LINK.disabled"; fi
if ! nginx -t; then [[ ! -L "$NGX_LINK.disabled" ]] || mv "$NGX_LINK.disabled" "$NGX_LINK"; fail 'Nginx validation failed, restored link'; fi
systemctl reload nginx
if (( ! PURGE )); then
  [[ ! -L "$NGX_LINK.disabled" ]] || mv "$NGX_LINK.disabled" "$NGX_LINK"
  fail 'Deletion requires --purge-data. To disable the site, use site-disable.'
fi
# Drop enabled site before turning off the FPM pool.
rm -f -- "$NGX_LINK.disabled"
if [[ -f "$FPM_CONF" ]]; then mv "$FPM_CONF" "$FPM_CONF.disabled"; fi
if ! "php-fpm$PHP_VERSION" -t; then [[ ! -f "$FPM_CONF.disabled" ]] || mv "$FPM_CONF.disabled" "$FPM_CONF"; fail 'PHP-FPM validation failed'; fi
systemctl reload "php$PHP_VERSION-fpm"
rm -f -- "$FPM_CONF.disabled"
# Safe explicit database register: name\tuser\tseparate-account flag
if [[ -f $(extra_registry) ]]; then
 while IFS=$'\t' read -r database username separate; do
  [[ "$database" =~ ^[a-z0-9_]{1,64}$ && "$username" =~ ^[a-z0-9_]{1,64}$ ]] || fail 'Invalid database registry'
  mysql -e "DROP DATABASE IF EXISTS \`$database\`;"
  if [[ $separate == yes ]]; then mysql -e "DROP USER IF EXISTS '$username'@'localhost';"; fi
 done < "$(extra_registry)"
fi
mysql -e "DROP DATABASE IF EXISTS \`$DB_NAME\`; DROP USER IF EXISTS '$SITE_USER'@'localhost';"
crontab -u "$SITE_USER" -r 2>/dev/null || true
rm -f -- "$NGX_CONF" "$CRED_FILE" "$(extra_registry)" "$STATE"
[[ ! -d "$INC_DIR" ]] || rm -rf -- "$INC_DIR"
[[ ! -d "$WEB_ROOT" ]] || rm -rf -- "$WEB_ROOT"
getent passwd "$SITE_USER" >/dev/null && userdel "$SITE_USER" || true
getent group "$SITE_USER" >/dev/null && groupdel "$SITE_USER" || true
echo 'Deleted site resources. Certbot certificate not removed.'
