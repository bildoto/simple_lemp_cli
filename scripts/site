#!/usr/bin/env bash
set -euo pipefail

AVAILABLE_DIR="/etc/nginx/sites-available"
ENABLED_DIR="/etc/nginx/sites-enabled"

require_dirs() {
    if [[ ! -d "$AVAILABLE_DIR" ]]; then
        echo "Error: $AVAILABLE_DIR does not exist."
        echo "Install nginx first, or create the Debian-style sites-available directory."
        exit 1
    fi

    if [[ ! -d "$ENABLED_DIR" ]]; then
        echo "Error: $ENABLED_DIR does not exist."
        echo "Install nginx first, or create the Debian-style sites-enabled directory."
        exit 1
    fi
}

create_site_prompt() {
    local mode="${1:-ssl}"
    local domain
    read -rp "Domain: " domain

    if [[ -z "$domain" ]]; then
        echo "No domain entered."
        return
    fi

    case "$mode" in
        ssl) site-create "$domain" ;;
        no-ssl) site-create "$domain" --no-ssl ;;
        *) echo "Unknown SSL mode: $mode" >&2; return 1 ;;
    esac
}

list_sites() {
    require_dirs

    while true; do
        mapfile -t sites < <(
            find "$AVAILABLE_DIR" -maxdepth 1 -type f -name "*.conf" \
                -printf "%f\n" | sed 's/\.conf$//' | sort
        )

        if [[ ${#sites[@]} -eq 0 ]]; then
            echo
            echo "No sites found."
            echo
            echo "[1] Create site (with SSL)"
            echo "[2] Create site (without SSL)"
            echo "[3] Check server prerequisites"
            echo "[0] Exit"
            echo

            read -rp "Choose action: " action

            case "$action" in
                1|2)
                    if [[ "$action" == 1 ]]; then
                        create_site_prompt ssl
                    else
                        create_site_prompt no-ssl
                    fi
                    echo
                    read -rp "Press Enter to continue..."
                    ;;
                3)
                    site-check
                    echo
                    read -rp "Press Enter to continue..."
                    ;;
                0|q|quit|exit)
                    exit 0
                    ;;
                *)
                    echo "Invalid action."
                    echo
                    read -rp "Press Enter to continue..."
                    ;;
            esac

            continue
        fi

        echo
        echo "Sites"
        echo

        for i in "${!sites[@]}"; do
            domain="${sites[$i]}"

            if [[ -L "$ENABLED_DIR/$domain.conf" ]]; then
                status="active"
            else
                status="inactive"
            fi

            printf "[%d] %-35s %s\n" "$((i + 1))" "$domain" "$status"
        done

        echo
        echo "[c] Create site (with SSL)"
        echo "[n] Create site (without SSL)"
        echo "[h] Check server prerequisites"
        echo "[q] Quit"
        echo

        read -rp "Select site number: " choice

        case "$choice" in
            c|create|n)
                if [[ "$choice" == n ]]; then
                    create_site_prompt no-ssl
                else
                    create_site_prompt ssl
                fi
                echo
                read -rp "Press Enter to continue..."
                continue
                ;;
            h|check)
                site-check
                echo
                read -rp "Press Enter to continue..."
                continue
                ;;
            q|quit|exit)
                exit 0
                ;;
        esac

        if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
            echo "Invalid selection."
            echo
            read -rp "Press Enter to continue..."
            continue
        fi

        index=$((choice - 1))

        if [[ -z "${sites[$index]:-}" ]]; then
            echo "Invalid selection."
            echo
            read -rp "Press Enter to continue..."
            continue
        fi

        selected="${sites[$index]}"
        site_menu "$selected"
    done
}

database_menu() {
    local domain="$1" action
    while true; do
        echo
        echo "Manage databases — $domain"
        # Current states are queried from MariaDB on every menu refresh.
        if ! site-database-privileges "$domain" list; then
            echo 'Unable to determine database privileges; management disabled.'
            return 1
        fi
        echo
        echo "[1] Create additional database"
        echo "[2] Delete additional database"
        echo "[3] Change database privilege level (RESTRICTED ↔ ELEVATED)"
        echo "[0] Back"
        read -rp "Choose action: " action
        case "$action" in
            1) site-database-create "$domain" ;;
            2) site-database-delete "$domain" ;;
            3) site-database-privileges "$domain" toggle ;;
            0|b|back) return ;;
            *) echo "Invalid action." ;;
        esac
        echo
        read -rp "Press Enter to continue..."
    done
}

site_menu() {
    local domain="$1"

    while true; do
        echo
        echo "Selected: $domain"
        echo
        echo "[1]  Enable"
        echo "[2]  Disable"
        echo "[3]  Show credentials"
        echo "[4]  Manage databases"
        echo "[5]  Show DNS records"
        echo "[6]  Password protect path"
        echo "[7]  Remove password protection"
        echo "[8]  Add protection user"
        echo "[9]  Remove protection user"
        echo "[10] Delete site"
        echo "[11] Configure / retry Let's Encrypt SSL"
        echo "[12] Site identity / information"
        echo "[0]  Back"
        echo

        read -rp "Choose action: " action

        case "$action" in
            1)
                site-enable "$domain"
                ;;
            2)
                site-disable "$domain"
                ;;
            3)
                site-credentials "$domain"
                ;;
            4)
                database_menu "$domain"
                ;;
            5)
                site-dns "$domain"
                ;;
            6)
                read -rp "Path to protect, for example /status/: " protect_path
                site-protect "$domain" "$protect_path"
                ;;
            7)
                site-unprotect "$domain"
                ;;
            8)
                read -rp "Protected path, for example /status/: " protect_path
                site-protect-user-add "$domain" "$protect_path"
                ;;
            9)
                read -rp "Protected path, for example /status/: " protect_path
                site-protect-user-remove "$domain" "$protect_path"
                ;;
            10)
                echo
                echo "Deletion options for $domain:"
                echo "[1] Preview resources only"
                echo "[2] Permanently delete site, databases and files"
                echo "[0] Cancel"
                read -rp "Choose deletion mode: " deletion_mode
                case "$deletion_mode" in
                    1) site-delete "$domain" ;;
                    2)
                        echo "WARNING: this permanently deletes the site's files, databases and account."
                        read -rp "Type DELETE $domain to confirm: " confirmation
                        if [[ "$confirmation" == "DELETE $domain" ]]; then
                            site-delete "$domain" --confirm --purge-data
                            return
                        else
                            echo "Cancelled."
                        fi
                        ;;
                    0) echo "Cancelled." ;;
                    *) echo "Invalid selection." ;;
                esac
                ;;
            11)
                site-ssl "$domain"
                ;;
            12)
                site-info "$domain"
                ;;
            0|b|back)
                return
                ;;
            *)
                echo "Invalid action."
                ;;
        esac

        echo
        read -rp "Press Enter to continue..."
    done
}

case "${1:-}" in
    create)
        # Forward --no-ssl to site-create when used noninteractively.
        site-create "${@:2}"
        ;;
    info)
        site-info "${2:-}"
        ;;
    ssl)
        site-ssl "${2:-}"
        ;;
    enable)
        site-enable "${2:-}"
        ;;
    disable)
        site-disable "${2:-}"
        ;;
    delete)
        site-delete "${2:-}"
        ;;
    credentials)
        site-credentials "${2:-}"
        ;;
    database-privileges|db-privileges)
        site-database-privileges "${2:-}" "${3:-list}" "${4:-}"
        ;;
    database-create|db-create)
        site-database-create "${2:-}" "${3:-}"
        ;;
    database-delete|db-delete)
        site-database-delete "${2:-}" "${3:-}"
		;;
	dns)
		site-dns "${2:-}"
        ;;
	protect)
		site-protect "${2:-}" "${3:-}"
		;;
	unprotect)
		site-unprotect "${2:-}" "${3:-}"
		;;
	protect-user-add)
        site-protect-user-add "${2:-}" "${3:-}" "${4:-}"
        ;;
    protect-user-remove)
        site-protect-user-remove "${2:-}" "${3:-}" "${4:-}"
        ;;
    ""|list)
        list_sites
        ;;
    *)
        echo "Usage:"
        echo "  site"
        echo "  site create example.com"
        echo "  site create example.com --no-ssl"
        echo "  site ssl example.com"
        echo "  site enable example.com"
        echo "  site disable example.com"
        echo "  site delete example.com"
        echo "  site credentials example.com"
        echo "  site database-privileges example.com list|elevate|restrict [database]"
        echo "  site database-create example.com logs"
        echo "  site database-delete example.com logs"
		echo "  site dns example.com"
		echo "  site unprotect example.com /status/"
		echo "  site protect-user-add example.com /status/ admin"
		echo "  site protect-user-remove example.com /status/ admin"        
		exit 1
        ;;
esac