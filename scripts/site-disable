#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -eq 1 ]] || fail 'Usage: site-disable example.com'
load_site "$1"
CONF="$NGX_CONF"; LINK="$NGX_LINK"
DISABLED_CONF="$NGX_AVAIL/$DOMAIN.disabled.conf"
[[ -f "$CONF" && ! -L "$CONF" ]] || fail 'Missing or unsafe active site configuration'
if [[ -L "$LINK" && $(readlink "$LINK") == "$DISABLED_CONF" ]]; then
  echo "Site already disabled: $DOMAIN"; exit 0
fi
[[ -L "$LINK" && $(readlink "$LINK") == "$CONF" ]] || fail 'Unexpected or missing enabled-site symlink'
[[ ! -e "$DISABLED_CONF" && ! -L "$DISABLED_CONF" ]] || fail "Disabled configuration already exists: $DISABLED_CONF"
# Only use existing, matching certificate files. Never fabricate TLS certificates.
CERT="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"
KEY="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
TMP=$(mktemp "$NGX_AVAIL/.${DOMAIN}.disabled.XXXXXXXX")
trap 'rm -f -- "$TMP"' EXIT
{
  printf 'server {\n    listen 80;\n    server_name %s;\n' "$DOMAIN"
  printf '    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; try_files $uri =404; }\n'
  printf '    location / { return 503; }\n}\n'
  if [[ -s "$CERT" && -s "$KEY" ]]; then
    printf 'server {\n    listen 443 ssl;\n    server_name %s;\n' "$DOMAIN"
    printf '    ssl_certificate %s;\n    ssl_certificate_key %s;\n' "$CERT" "$KEY"
    printf '    location / { return 503; }\n}\n'
  else
    echo 'Note: no site-specific certificate found; disabled state is HTTP-only.' >&2
  fi
} > "$TMP"
chmod 644 "$TMP"
mv -- "$TMP" "$DISABLED_CONF"
# Change link atomically; rollback files are never stored in sites-enabled.
NEXT_LINK=$(mktemp -u "$NGX_ENABLED/.${DOMAIN}.XXXXXXXX")
ln -s -- "$DISABLED_CONF" "$NEXT_LINK"
mv -Tf -- "$NEXT_LINK" "$LINK"
if ! nginx -t || ! systemctl reload nginx; then
  NEXT_LINK=$(mktemp -u "$NGX_ENABLED/.${DOMAIN}.XXXXXXXX")
  ln -s -- "$CONF" "$NEXT_LINK"
  mv -Tf -- "$NEXT_LINK" "$LINK"
  rm -f -- "$DISABLED_CONF"
  nginx -t >&2 || true
  systemctl reload nginx || true
  fail 'Disabling failed; original site restored'
fi
echo "Site disabled: $DOMAIN (503 maintenance response)"
