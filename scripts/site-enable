#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -eq 1 ]] || fail 'Usage: site-enable example.com'
load_site "$1"
CONF="$NGX_CONF"; LINK="$NGX_LINK"
DISABLED_CONF="$NGX_AVAIL/$DOMAIN.disabled.conf"
[[ -f "$CONF" && ! -L "$CONF" ]] || fail 'Missing or unsafe site configuration'
if [[ -L "$LINK" && $(readlink "$LINK") == "$CONF" ]]; then
  echo "Site already enabled: $DOMAIN"; exit 0
fi
if [[ -L "$LINK" ]]; then
  [[ $(readlink "$LINK") == "$DISABLED_CONF" && -f "$DISABLED_CONF" ]] || fail 'Unexpected site symlink; refusing to modify'
elif [[ -e "$LINK" ]]; then
  fail 'Site link is not a symlink'
fi
PREVIOUS=""
[[ -L "$LINK" ]] && PREVIOUS=$(readlink "$LINK")
NEXT_LINK=$(mktemp -u "$NGX_ENABLED/.${DOMAIN}.XXXXXXXX")
ln -s -- "$CONF" "$NEXT_LINK"
mv -Tf -- "$NEXT_LINK" "$LINK"
if ! nginx -t || ! systemctl reload nginx; then
  if [[ -n "$PREVIOUS" ]]; then
    NEXT_LINK=$(mktemp -u "$NGX_ENABLED/.${DOMAIN}.XXXXXXXX")
    ln -s -- "$PREVIOUS" "$NEXT_LINK"
    mv -Tf -- "$NEXT_LINK" "$LINK"
  else
    rm -f -- "$LINK"
  fi
  nginx -t >&2 || true
  systemctl reload nginx || true
  fail 'Enabling failed; previous state restored'
fi
[[ -z "$PREVIOUS" ]] || rm -f -- "$DISABLED_CONF"
echo "Site enabled: $DOMAIN"
