#!/usr/bin/env bash
set -euo pipefail

DOMAIN="${1:-}"
if [[ -z "$DOMAIN" ]]; then
    echo "Usage: site-enable example.com"
    exit 1
fi

CONF="/etc/nginx/sites-available/$DOMAIN.conf"
LINK="/etc/nginx/sites-enabled/$DOMAIN.conf"

if [[ ! -f "$CONF" ]]; then
    echo "Error: site config not found: $CONF" >&2
    exit 1
fi

if [[ -L "$LINK" ]]; then
    if [[ "$(readlink "$LINK")" != "$CONF" ]]; then
        echo "Error: unexpected symlink target for $LINK; refusing to modify it" >&2
        exit 1
    fi
    echo "Site is already enabled: $DOMAIN"
    exit 0
fi
if [[ -e "$LINK" ]]; then
    echo "Error: $LINK already exists and is not a symlink" >&2
    exit 1
fi

ln -s -- "$CONF" "$LINK"
if ! nginx -t || ! systemctl reload nginx; then
    rm -- "$LINK"
    echo "Error: enabling failed; previous Nginx configuration restored" >&2
    nginx -t >&2 || true
    systemctl reload nginx || true
    exit 1
fi

echo "Site enabled: $DOMAIN"
