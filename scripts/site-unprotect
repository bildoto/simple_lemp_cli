#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -ge 1 && $# -le 2 ]] || fail 'Usage: site-unprotect domain [path]'
load_site "$1"; path="${2:-}"; cfg="$INC_DIR/protection.conf"
[[ -f $cfg ]] || fail 'Protection config missing'
mapfile -t endpoints < <(sed -n 's/^# SITE-MANAGER-PROTECT-BEGIN: //p' "$cfg")
if [[ -z $path ]]; then
 ((${#endpoints[@]})) || { echo 'No protected paths'; exit 0; }
 for i in "${!endpoints[@]}"; do printf '[%d] %s\n' "$((i+1))" "${endpoints[i]}"; done
 read -rp 'Select path (0=cancel): ' choice
 [[ $choice =~ ^[0-9]+$ ]] || fail 'Invalid selection'
 ((10#$choice > 0 && 10#$choice <= ${#endpoints[@]})) || exit 0
 path=${endpoints[10#$choice-1]}
fi
[[ $path =~ ^/([A-Za-z0-9_-]+/)+$ || $path =~ ^/[A-Za-z0-9_-]+\.php$ ]] || fail 'Invalid path'
grep -Fxq "# SITE-MANAGER-PROTECT-BEGIN: $path" "$cfg" || fail 'Not protected'
read -rp "Remove protection for $path? Type REMOVE: " confirm
[[ $confirm == REMOVE ]] || exit 0
cp -p "$cfg" "$cfg.backup"
awk -v ep="$path" '$0=="# SITE-MANAGER-PROTECT-BEGIN: "ep {hide=1;next} $0=="# SITE-MANAGER-PROTECT-END: "ep {hide=0;next} !hide {print}' "$cfg.backup" > "$cfg"
if nginx -t && systemctl reload nginx; then
 rm -f "$cfg.backup"
 echo "Removed $path (password file retained)"
else
 mv "$cfg.backup" "$cfg"; fail 'Restored protection after failed config test'
fi
