#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -eq 1 ]] || fail 'Usage: site-credentials domain'
load_site "$1"
echo "Site: $DOMAIN (user: $SITE_USER)"
echo "Primary database: $DB_NAME"
echo "Credentials: $CRED_FILE"
[[ -f $CRED_FILE ]] && cat "$CRED_FILE"
echo 'Additional registered databases:'
[[ ! -f $(extra_registry) ]] || column -s $'\t' -t "$(extra_registry)" || cat "$(extra_registry)"
