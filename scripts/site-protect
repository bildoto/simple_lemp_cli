#!/usr/bin/env bash
set -Eeuo pipefail
source /usr/local/lib/site-manager/site-common
require_root
[[ $# -ge 2 ]] || fail 'Usage: site-protect domain /path/ [username]'
load_site "$1"; endpoint="$2"; username="${3:-}"
[[ "$endpoint" =~ ^/([A-Za-z0-9_-]+/)+$ || "$endpoint" =~ ^/[A-Za-z0-9_-]+\.php$ ]] || fail 'Only simple directory paths (/status/) or root PHP files (/admin.php) are supported'
[[ -f "$INC_DIR/protection.conf" ]] || fail 'Missing protection.conf'
safe=${endpoint#/}; safe=${safe//\//_}; safe=${safe%.php}; safe=${safe%_}
[[ $safe =~ ^[A-Za-z0-9_-]+$ ]] || fail 'Invalid path'
authdir=/etc/nginx/htpasswd; authfile="$authdir/$DOMAIN-$safe.htpasswd"
command -v htpasswd >/dev/null || fail 'apache2-utils is required'
if [[ -z $username ]]; then read -rp 'Basic Auth username: ' username; fi
[[ $username =~ ^[A-Za-z0-9_.-]+$ ]] || fail 'Invalid username'
marker="# SITE-MANAGER-PROTECT-BEGIN: $endpoint"
! grep -Fxq "$marker" "$INC_DIR/protection.conf" || fail 'Already protected'
mkdir -p "$authdir"; chmod 755 "$authdir"
if [[ -f $authfile ]]; then htpasswd -B "$authfile" "$username"; else htpasswd -cB "$authfile" "$username"; fi
chown root:www-data "$authfile"; chmod 640 "$authfile"
cfg="$INC_DIR/protection.conf"; cp -p "$cfg" "$cfg.backup"
if [[ $endpoint == *.php ]]; then
 cat >> "$cfg" <<NGINX
$marker
location = $endpoint {
    auth_basic "Restricted";
    auth_basic_user_file $authfile;
    include snippets/fastcgi-php.conf;
    fastcgi_pass unix:$SOCKET;
}
# SITE-MANAGER-PROTECT-END: $endpoint
NGINX
else
 cat >> "$cfg" <<NGINX
$marker
location ^~ $endpoint {
    auth_basic "Restricted";
    auth_basic_user_file $authfile;
    location ~ \.php\$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:$SOCKET;
    }
    try_files \$uri \$uri/ ${endpoint}index.php?\$query_string;
}
# SITE-MANAGER-PROTECT-END: $endpoint
NGINX
fi
if nginx -t && systemctl reload nginx; then rm -f "$cfg.backup"; echo 'Protection enabled'; else mv "$cfg.backup" "$cfg"; nginx -t || true; fail 'Nginx invalid; protection reverted'; fi
